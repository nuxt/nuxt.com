{
  "name": "nuxt.com",
  "version": "0.3.11",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --ui-only",
    "dev:nuxi": "nuxt dev --ui-only --with-nuxi",
    "dev:full": "nuxt dev",
    "nuxi": "pnpm --dir layers/nuxi run dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --cache",
    "typecheck": "nuxt typecheck",
    "test": "pnpm lint && pnpm test:types && pnpm vitest run && pnpm test:browser",
    "test:types": "vue-tsc -b --noEmit",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:browser": "playwright test test/browser",
    "test:browser:update": "docker run --rm --network host -v $(pwd):/work/ -v /tmp/playwright-node-modules:/work/node_modules -w /work/ -it mcr.microsoft.com/playwright:v1.57.0-noble bash -c 'corepack enable && pnpm i && pnpm playwright test test/browser --update-snapshots'",
    "eval": "evalite",
    "eval:ui": "evalite serve",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.36",
    "@chat-adapter/discord": "^4.38.1",
    "@chat-adapter/state-memory": "^4.38.1",
    "@chat-adapter/state-redis": "^4.38.1",
    "@comark/nuxt": "^0.6.2",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/lucide": "^1.2.125",
    "@iconify-json/octicon": "^1.2.32",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/vscode-icons": "^1.2.74",
    "@libsql/client": "^0.17.4",
    "@npm/types": "^2.1.0",
    "@nuxt/content": "^3.15.2",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.8",
    "@nuxt/ui": "^4.11.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/html-validator": "^2.1.0",
    "@nuxtjs/mcp-toolkit": "^0.19.0",
    "@nuxtjs/mdc": "^0.23.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@takumi-rs/core": "^2.11.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/connect": "^0.9.0",
    "@vercel/functions": "^3.9.5",
    "@vercel/global-config": "^1.5.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vue/compiler-sfc": "^3.5.41",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "ai": "^7.0.77",
    "better-sqlite3": "^13.0.3",
    "chat": "^4.38.1",
    "comark-content": "https://pkg.pr.new/comark-content@e2df8d0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.44.3",
    "evlog": "^2.26.0",
    "feed": "^5.2.1",
    "h3": "^1.15.11",
    "little-date": "^1.2.1",
    "motion-v": "^2.4.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-charts": "^2.2.1",
    "nuxt-llms": "^0.2.0",
    "nuxt-og-image": "^6.7.8",
    "nuxt-schema-org": "^6.3.0",
    "ofetch": "^1.5.1",
    "rangi": "^2.2.0",
    "resend": "^6.22.0",
    "scule": "^1.3.0",
    "shaders": "^3.1.457",
    "sitemap": "^9.0.1",
    "std-env": "^4.2.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "valibot": "^1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/modules": "^0.6.0-fde89f",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/turnstile": "^1.1.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@types/semver": "^7.8.0",
    "@types/youtube": "^0.3.0",
    "@vue/test-utils": "^2.4.11",
    "capture-website": "^5.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "evalite": "1.0.0-beta.16",
    "happy-dom": "^20.11.6",
    "microsandbox": "^0.6.14",
    "nuxt-content-twoslash": "^0.4.0",
    "nuxtseo-layer-devtools": "^5.3.14",
    "playwright": "^1.62.1",
    "shiki": "^4.4.3",
    "twoslash": "^0.3.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "zlib-sync": "^0.1.10"
  }
}
