{
  "name": "nuxt.com",
  "version": "0.3.11",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24 || ^26",
      "onFail": "warn"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --ui-only",
    "dev:nuxi": "nuxt dev --ui-only --with-nuxi",
    "dev:full": "nuxt dev",
    "nuxi": "pnpm --dir layers/nuxi run dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --cache",
    "typecheck": "nuxt typecheck",
    "test": "pnpm lint && pnpm test:types && pnpm vitest run && pnpm test:browser",
    "test:types": "vue-tsc -b --noEmit",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:browser": "playwright test test/browser",
    "test:browser:update": "docker run --rm --network host -v $(pwd):/work/ -v /tmp/playwright-node-modules:/work/node_modules -w /work/ -it mcr.microsoft.com/playwright:v1.57.0-noble bash -c 'corepack enable && pnpm i && pnpm playwright test test/browser --update-snapshots'",
    "eval": "evalite",
    "eval:ui": "evalite serve",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.66",
    "@chat-adapter/discord": "^4.41.1",
    "@chat-adapter/state-memory": "^4.41.1",
    "@chat-adapter/state-redis": "^4.41.1",
    "@comark/nuxt": "^0.7.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/octicon": "^1.2.37",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/vscode-icons": "^1.2.84",
    "@libsql/client": "^0.18.0",
    "@npm/types": "^2.1.0",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "^4.11.3",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/html-validator": "^2.1.0",
    "@nuxtjs/mcp-toolkit": "^0.24.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@takumi-rs/core": "^2.14.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/connect": "^2.4.0",
    "@vercel/functions": "^3.9.11",
    "@vercel/global-config": "^1.5.1",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "@vue/compiler-sfc": "^3.5.43",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "ai": "^7.0.127",
    "chat": "^4.41.1",
    "comark-content": "^0.4.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "eve": "^0.71.0",
    "evlog": "^2.30.0",
    "feed": "^5.2.1",
    "fflate": "^0.8.3",
    "h3": "^1.15.11",
    "little-date": "^1.2.1",
    "motion-v": "^2.5.2",
    "nuxt": "^4.6.0",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-charts": "^2.2.3",
    "nuxt-llms": "https://pkg.pr.new/nuxt-content/nuxt-llms/nuxt-llms@f6a9730",
    "nuxt-og-image": "^6.10.3",
    "nuxt-schema-org": "^6.4.3",
    "nuxt-workers": "^0.1.0",
    "ofetch": "^1.5.1",
    "rangi": "^2.2.0",
    "resend": "^6.32.0",
    "scule": "^1.3.0",
    "shaders": "^3.2.475",
    "std-env": "^4.3.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "valibot": "^1.5.0",
    "verkit": "^0.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/modules": "^0.6.0-fde89f",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sitemap": "^8.6.1",
    "@nuxtjs/turnstile": "^1.1.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/vue": "^8.1.0",
    "@types/youtube": "^0.3.0",
    "@vue/test-utils": "^2.5.1",
    "capture-website": "^5.1.0",
    "confbox": "^0.2.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "evalite": "1.0.0-beta.16",
    "happy-dom": "^20.14.5",
    "microsandbox": "^0.7.6",
    "nuxt-agent-discovery": "^0.7.0",
    "nuxtseo-layer-devtools": "^5.3.16",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "zlib-sync": "^0.1.10"
  }
}
